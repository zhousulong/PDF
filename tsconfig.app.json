{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/utils/scan-renderer": ["scan/src/utils/scan-renderer/index.ts"],
      "@/utils/scan-renderer/*": ["scan/src/utils/scan-renderer/*"],
      "@/composables/save-scanned-pdf": ["scan/src/composables/save-scanned-pdf/index.ts"],
      "@/composables/save-scanned-pdf/*": ["scan/src/composables/save-scanned-pdf/*"],
      "@/utils/print-renderer": ["print/src/utils/print-renderer/index.ts"],
      "@/utils/print-renderer/*": ["print/src/utils/print-renderer/*"],
      "@/composables/save-printed-pdf": ["print/src/composables/save-printed-pdf/index.ts"],
      "@/composables/save-printed-pdf/*": ["print/src/composables/save-printed-pdf/*"],
      "@/utils/pdf-renderer/*": ["scan/src/utils/pdf-renderer/*"],
      "@/utils/pdf-builder/*": ["scan/src/utils/pdf-builder/*"],
      "@/components/scan-settings/*": ["scan/src/components/scan-settings/*"],
      "@/components/print-settings/*": ["print/src/components/print-settings/*"],
      "@/components/pdf-upload/*": ["scan/src/components/pdf-upload/*"],
      "@/components/save-button/*": ["scan/src/components/save-button/*"],
      "@/components/page-preview/*": ["scan/src/components/page-preview/*"],
      "@/components/Header/*": ["scan/src/components/Header/*"],
      "@/components/Footer/*": ["scan/src/components/Footer/*"],
      "@/components/Misc/*": ["scan/src/components/Misc/*"],
      "@/assets/examples/*": ["scan/src/assets/examples/*"],
      "@/*": ["src/*", "scan/src/*", "print/src/*", "stamp/src/*"]
    }
  },
  "include": [
    "src/env.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "scan/src/**/*.ts",
    "scan/src/**/*.vue",
    "print/src/**/*.ts",
    "print/src/**/*.vue"
  ],
  "exclude": [
    "scan/src/main.ts",
    "print/src/main.ts",
    "scan/src/router/index.ts"
  ]
}
