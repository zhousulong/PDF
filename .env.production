# User-facing site (SEO / canonical / JSON-LD). Never point this at the CDN.
VITE_SITE_ORIGIN=https://www.9ump.com

# CDN origin (PWA runtimeCaching + docs).
VITE_CDN_ORIGIN=https://pdf.yunno.net

# Production always emits absolute asset URLs so www.9ump.com loads JS/CSS from the CDN.
# EdgeOne default build command `pnpm build` / `npm run build` will pick this up.
# Override only for a pure same-origin build: VITE_ASSET_BASE=/ pnpm build:site
VITE_ASSET_BASE=https://pdf.yunno.net/
