# User-facing site (SEO / canonical / JSON-LD). Never point this at the CDN.
VITE_SITE_ORIGIN=https://www.9ump.com

# CDN origin (used by PWA runtimeCaching when assets are absolute).
VITE_CDN_ORIGIN=https://pdf.yunno.net

# Asset base is NOT set here on purpose.
# - Same-origin site build:  leave unset (base = /)
# - CDN asset build:         VITE_ASSET_BASE=https://pdf.yunno.net/ pnpm build:cdn
